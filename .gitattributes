# 让 Git 自动识别文本文件，并在仓库内统一以 LF 存储，避免 Windows/Linux 协作时换行符混乱
* text=auto

# 明确指定常见文本文件按 LF 存储
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf

# 明确指定二进制文件，禁止 Git 做换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.iso    binary
*.hex    binary
*.bin    binary
